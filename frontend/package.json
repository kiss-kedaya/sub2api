{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:console": "node dev/serve.mjs",
    "check:i18n": "vitest run src/i18n/__tests__/localeKeyCompleteness.spec.ts",
    "build": "pnpm run check:i18n && vue-tsc -b && vite build && node dev/check-console-assets.mjs && node scripts/build-manifest.mjs emit --dir ../backend/internal/web/dist --mode spa",
    "build:ssr": "node scripts/require-node.mjs && nuxt build && node scripts/build-manifest.mjs emit --dir .output --mode ssr",
    "verify:embed": "node scripts/build-manifest.mjs verify --dir ../backend/internal/web/dist --mode spa",
    "verify:ssr": "node scripts/build-manifest.mjs verify --dir .output --mode ssr",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.150",
    "@iconify/vue": "^5.0.4",
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "^4.12.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.20.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.17",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@intlify/message-compiler": "9.14.5",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "nuxt": "4.6.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.0",
    "vite": "^5.0.10",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=24.15"
  },
  "pnpm": {
    "overrides": {
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "follow-redirects@<1.16.1": "1.16.1",
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.17": ">=3.4.17",
      "source-map-js@<1.2.2": ">=1.2.2",
      "follow-redirects": "1.16.1"
    }
  },
  "packageManager": "pnpm@9.15.5"
}
