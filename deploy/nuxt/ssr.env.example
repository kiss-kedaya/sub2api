# 复制成 /opt/sub2api/ssr/.env，权限 0600。
# 只允许 http/https，且不能带账号密码。
NUXT_BACKEND_ORIGIN=http://127.0.0.1:8080
# 生成：openssl rand -base64 48
NUXT_SESSION_PASSWORD=
NUXT_SESSION_COOKIE_SECURE=auto
NUXT_BACKEND_TIMEOUT_MS=180000
NUXT_SSR_VERSION=2.3.0
NUXT_SSR_COMMIT=
NUXT_SSR_BUILT_AT=
NUXT_EXPECTED_BACKEND_VERSION=2.3.0
# 本机监听，交给 nginx 反代
HOST=127.0.0.1
PORT=3000
