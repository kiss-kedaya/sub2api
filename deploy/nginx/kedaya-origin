server {
    listen 80;
    listen [::]:80;
    server_name kedaya.ai;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kedaya.ai;

    ssl_certificate     /etc/nginx/ssl/kedaya.ai.crt;
    ssl_certificate_key /etc/nginx/ssl/kedaya.ai.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/cloudflare.conf;

    client_max_body_size 256m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    include /etc/nginx/snippets/grafana-location.conf;
    include /etc/nginx/snippets/infinite-canvas.conf;
    include /etc/nginx/snippets/sub2api-backend-locations.conf;
    include /etc/nginx/snippets/sub2api-spa.conf;
}
