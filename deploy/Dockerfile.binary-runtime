# Minimal runtime image for a prebuilt Linux/amd64 Sub2API binary.
# The binary is built outside Docker so release verification can compare its
# ELF signature and SHA-256 before it is shipped to a production host.
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata curl su-exec \
    && addgroup -g 1000 sub2api \
    && adduser -u 1000 -G sub2api -s /bin/sh -D sub2api

WORKDIR /app
COPY sub2api /app/sub2api
COPY docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod 0755 /app/sub2api /app/docker-entrypoint.sh \
    && mkdir -p /app/data \
    && chown -R sub2api:sub2api /app

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS --max-time 5 http://127.0.0.1:${SERVER_PORT:-8080}/health >/dev/null

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/sub2api"]
